  "sources": [
    {
      "id": "fao56",
      "label": "FAO-56 Table 19",
      "note": "Class-mean values from Allen et al. (1998) FAO-56, Table 19 (mid-range of the tabulated field-capacity and wilting-point bands). Table 19 lists nine classes; the others show no value."
    },
    {
      "id": "saxton",
      "label": "Saxton & Rawls 2006",
      "note": "Pedotransfer regressions (Saxton & Rawls 2006, Table 1) evaluated at the class centroid texture with 2% organic matter. WP = θ(−1500 kPa), FC = θ(−33 kPa)."
    },
    {
      "id": "scott",
      "label": "Scott et al. 2013",
      "note": "van Genuchten retention from class-average parameters of the Oklahoma Mesonet (Scott & Ochsner 2013, via Rosetta). WP = θ(−1500 kPa). Field capacity is given at both −33 kPa and −10 kPa. Sand and silt were not sampled."
    },
    {
      "id": "parker",
      "label": "Parker et al. 2022",
      "note": "van Genuchten retention from class-average parameters of the Kansas Mesonet (Parker et al. 2022). WP = θ(−1500 kPa). Field capacity is given at both −33 kPa and −10 kPa. Four classes were not sampled."
    },
    {
      "id": "rosetta",
      "label": "Rosetta class average",
      "note": "van Genuchten retention from the Rosetta national class averages (Schaap et al. 2001), covering all 12 USDA classes. WP = θ(−1500 kPa). Field capacity is given at both −33 kPa and −10 kPa."
    },
    {
      "id": "unit1",
      "label": "Unit gradient 1 mm/day",
      "note": "Field capacity as the water content where unit-gradient drainage K(θ) = 1 mm/day (van Genuchten-Mualem, Rosetta parameters), an alternative to a fixed matric potential. WP = θ(−1500 kPa)."
    }
  ],
